{
  "name": "ai-character-creator-electron",
  "productName": "AI Character Creator",
  "version": "1.9.0",
  "private": true,
  "description": "Personal Electron app for AI character creation using OpenRouter (DeepSeek)",
  "author": "woopser",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --sourcemap",
    "dev:quiet": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -b",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "icons": "bun run scripts/generate-icons.ts",
    "dist:mac": "bun run build && electron-builder --mac --arm64 --x64",
    "dist:mac:dir": "bun run build && electron-builder --mac --arm64 --dir",
    "dist:win": "bun run build && electron-builder --win --x64",
    "dist:linux": "bun run build && electron-builder --linux --x64"
  },
  "build": {
    "appId": "com.woopser.ai-character-creator",
    "productName": "AI Character Creator",
    "asar": true,
    "afterSign": "scripts/after-sign.cjs",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "artifactName": "AI-Character-Creator-${version}-macOS-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "AI-Character-Creator-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "artifactName": "AI-Character-Creator-${version}-Linux-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "woopser-1",
      "repo": "ai-character-creator-electron",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "ai": "^6.0.196",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "motion": "^12.38.0",
    "nanoid": "^5.1.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.0.0",
    "png2icons": "^2.0.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "ultracite": "7.3.2",
    "vite": "^6.0.0"
  }
}
